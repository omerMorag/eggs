# --- Google OAuth (NextAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# --- Upstash Redis (התקדמות אישית + rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Neon Postgres (סיפורים, מחשבון עלות, מודרציה) ---
# DATABASE_URL: מחרוזת ה-connection ה"pooled" מ-Neon — משמשת את האתר בזמן ריצה.
DATABASE_URL=
# DATABASE_URL_UNPOOLED: מחרוזת ה-connection הישירה (לא pooled) מ-Neon —
# משמשת רק את drizzle-kit להרצת מיגרציות (npm run db:generate / db:migrate).
DATABASE_URL_UNPOOLED=

# --- הרשאת מנהלת (מודרציית סיפורים) ---
# רשימת אימיילים של Google מופרדת בפסיקים, שיקבלו הרשאת אישור/דחיית סיפורים.
ADMIN_EMAILS=
